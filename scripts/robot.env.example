# Legacy shared template. New deployments use host_ws/host.env.example or pi_ws/pi.env.example.
# Kept for existing local scripts/robot.env; copy measured values into the new workspace configs.
# Both hosts need the same domain, reachable network and compatible DDS settings.
export ROS_DOMAIN_ID=30
export ROS_LOCALHOST_ONLY=0
# Keep your previously verified DDS settings; these scripts do not change interfaces.
# export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
# export CYCLONEDDS_URI=/absolute/path/on/this/host/cyclonedds.xml

# Raspberry Pi acquisition (ignored by desktop RViz mode)
STM32_PORT=/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0
STM32_BAUD=115200
# Keep python until the C++ node is built and verified on the Pi; choose cpp to switch.
BRIDGE_IMPL=python
IMU_BUS=1
IMU_ADDRESS=104
ENABLE_LIDAR=true
# false: launch measured static mounting TFs; true: existing robot model provides BOTH.
USE_EXTERNAL_MOUNT_TF=false
# REQUIRED measured x y z roll pitch yaw, metres/radians. Do not guess zero rotation.
IMU_MOUNT=""
LIDAR_MOUNT=""

# Optional: override install prefixes only when using a different build directory.
# PI_INSTALL=/home/your-user/RosCar/pi_ws/install/pi_runtime
# LIDAR_INSTALL=/home/your-user/RosCar/pi_ws/install/pi_runtime
# RVIZ_CONFIG=/absolute/path/to/custom.rviz
