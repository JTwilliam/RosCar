# Ubuntu Desktop display configuration; copy to host_ws/host.env and edit.
# Trusted Bash syntax. Use matching domain/DDS settings on the Raspberry Pi.
export ROS_DOMAIN_ID=30
export ROS_LOCALHOST_ONLY=0
# Keep your verified network/DDS settings; no device paths or mounting TFs here.
# export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
# export CYCLONEDDS_URI=/absolute/path/on/this/host/cyclonedds.xml
# ROS_LOG_DIR defaults to host_ws/log/ros.
