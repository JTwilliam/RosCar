Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 40; 40; 40
    Fixed Frame: odom
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Show Arrows: true
      Show Axes: true
      Show Names: true
    - Class: rviz_default_plugins/Odometry
      Name: Filtered Odometry
      Enabled: true
      Keep: 150
      Shape:
        Value: Arrow
      Color: 0; 255; 128
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odometry/filtered
    - Class: rviz_default_plugins/Odometry
      Name: Wheel Odometry
      Enabled: true
      Keep: 150
      Shape:
        Value: Arrow
      Color: 255; 170; 0
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odom
    - Class: rviz_default_plugins/LaserScan
      Name: Laser Scan
      Enabled: true
      Size (Pixels): 3
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 255; 255
      Position Transformer: XYZ
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.8
      Yaw: 0.8
      Target Frame: <Fixed Frame>
Window Geometry:
  Width: 1280
  Height: 800
