# Raspberry Pi only. Copy to pi.env in this workspace and fill measured transforms.
export ROS_DOMAIN_ID=30
export ROS_LOCALHOST_ONLY=0
# Preserve the previously verified DDS settings for this physical host.
# export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
# export CYCLONEDDS_URI=/absolute/path/to/your/pi-dds.xml
STM32_PORT=/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0
STM32_BAUD=115200
BRIDGE_IMPL=cpp
IMU_BUS=1
IMU_ADDRESS=104
ENABLE_LIDAR=true
USE_EXTERNAL_MOUNT_TF=false
# Measured x y z roll pitch yaw; m/rad. Required unless model provides TF.
IMU_MOUNT=""
LIDAR_MOUNT=""
